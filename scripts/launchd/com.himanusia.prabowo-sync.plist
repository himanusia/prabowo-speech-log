<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.himanusia.prabowo-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>exec "$HOME/.hermes/workspace/prabowo-speech-log/scripts/sync.sh" 40</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>20</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/mac/.hermes/workspace/prabowo-speech-log/data/sync-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mac/.hermes/workspace/prabowo-speech-log/data/sync-launchd.log</string>
</dict>
</plist>
